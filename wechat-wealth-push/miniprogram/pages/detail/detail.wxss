/* pages/detail/detail.wxss */
.page {
  padding-bottom: 40rpx;
}
.head .title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-top: 14rpx;
}
.rate-block {
  text-align: center;
  padding: 10rpx 0;
}
.rate-label {
  margin-bottom: 10rpx;
}
.rate-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #d4380d;
  margin-bottom: 10rpx;
}
.field {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
}
.field:last-child {
  border-bottom: none;
}
.field-label {
  color: #8a909c;
  font-size: 26rpx;
}
.field-value {
  font-size: 27rpx;
  text-align: right;
  max-width: 60%;
}
.note {
  line-height: 1.6;
}
